# ── Copia este archivo como .env y rellena los valores ──────────────────────
# NUNCA subas .env a Git

# Seguridad
SECRET_KEY=pon-aqui-una-clave-larga-y-aleatoria-minimo-50-caracteres
DEBUG=False

# Hosts (dominio de Railway, ej: miapp.up.railway.app)
ALLOWED_HOSTS=miapp.up.railway.app

# Base de datos MySQL (Railway las inyecta automáticamente si conectas el DB)
MYSQLDATABASE=nombre_de_tu_db
MYSQLUSER=usuario
MYSQLPASSWORD=contraseña
MYSQLHOST=host.railway.internal
MYSQLPORT=3306

# Email Gmail
EMAIL_HOST_USER=tucorreo@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password-de-gmail
